{
  "name": "subrata-sikdar-devops-portfolio",
  "version": "1.1.0",
  "description": "Enterprise-grade portfolio showcasing AWS/Azure cloud architecture and Kubernetes orchestration by Subrata Sikdar",
  "author": "Subrata Sikdar <subratasikdarcareer@gmail.com>",
  "license": "MIT",
  "main": "index.html",
  "scripts": {
    "start": "python -m http.server 8000",
    "dev": "npx http-server -p 8000 -c-1",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "npx eslint .",
    "build:css": "npx tailwindcss -i ./src/input.css -o ./dist/output.css --watch"
  },
  "keywords": [
    "DevOps",
    "SRE",
    "AWS-Certified",
    "CKA",
    "Terraform",
    "Kubernetes",
    "CI-CD"
  ],
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "jsdom": "^23.0.1",
    "tailwindcss": "^3.4.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "js/*.js",
      "index.html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80
      }
    }
  }
}
